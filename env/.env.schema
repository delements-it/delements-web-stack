# Environment variable validation schema
# Used by scripts/00-preflight.sh to validate .env

REQUIRED_VARS=(
  "SHOPIFY_ACCESS_TOKEN"
  "SHOPIFY_DOMAIN"
  "WEBFLOW_TOKEN"
)

OPTIONAL_VARS=(
  "FIGMA_USER_ID"
  "FIGMA_MCP_REPO"
  "FIGMA_MCP_DIR"
  "BSI_ROOT"
  "OPENCLAW_GATEWAY_TOKEN"
  "OPENCLAW_GATEWAY_PORT"
  "OPENCLAW_DEFAULT_MODEL"
)

# Domain pattern validation
SHOPIFY_DOMAIN_PATTERN='^[a-z0-9-]+\.myshopify\.com$'

# BSI_ROOT defaults to ~/Documents/Business Systems Integration if not set
