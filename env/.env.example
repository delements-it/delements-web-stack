# ==============================================================================
# delements-web-stack — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in your actual values:
#   cp env/.env.example env/.env
#
# NEVER commit .env to version control.
# ==============================================================================

# --- Figma ---
# Your Figma user ID (found in Figma Desktop → Profile → URL)
FIGMA_USER_ID=

# Figma MCP server repo (default: clone from GitHub)
FIGMA_MCP_REPO=https://github.com/Antonytm/figma-mcp-server.git
FIGMA_MCP_DIR=$HOME/Documents/WORKSPACES/AI Coding Tools/figma-mcp-server

# --- Webflow ---
# Webflow API token (Settings → API → Generate token)
WEBFLOW_TOKEN=

# --- Shopify ---
# Shopify Admin API access token (Admin → Apps → Develop apps → Admin API)
SHOPIFY_ACCESS_TOKEN=

# Your Shopify store domain
SHOPIFY_DOMAIN=your-store.myshopify.com

# --- OpenClaw ---
# Gateway auth token (auto-generated if empty)
OPENCLAW_GATEWAY_TOKEN=

# Gateway port (default: 18789)
OPENCLAW_GATEWAY_PORT=18789

# Default model for BSI agents
OPENCLAW_DEFAULT_MODEL=openai/gpt-5.4-mini

# --- BSI Project Root ---
# Path to Business Systems Integration project directory
BSI_ROOT=$HOME/Documents/Business Systems Integration
